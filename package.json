{
  "name": "wedding-ngocanh",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Trang lộ trình cưới Thắng & Ngọc Anh, kèm trang phụ \"Ăn gì ở Hà Nội\"",
  "scripts": {
    "build": "node tools/build.mjs && node tools/prepare-deploy.mjs",
    "prepare:deploy": "node tools/prepare-deploy.mjs",
    "test": "node --test \"tests/**/*.test.mjs\"",
    "serve": "python -m http.server 8000",
    "deploy": "npm run prepare:deploy && wrangler deploy",
    "preview": "wrangler dev"
  },
  "devDependencies": {
    "playwright": "^1.50.0",
    "wrangler": "^4.157.0"
  }
}
